# Copy to .env and `chmod 600 .env`. Only non-secret settings belong here;
# secrets live in ./secrets/ and are created by scripts/setup-secrets.sh.

# Name of the dedicated Tailscale node (sidecar). Public URL: https://<TS_HOSTNAME>.<tailnet DNS suffix>
TS_HOSTNAME=fitness-mcp
# Tag advertised by the sidecar node. It must be listed in tagOwners and carry
# the "funnel" nodeAttr in your tailnet policy file (see README).
TS_TAG=tag:fitness-mcp

# OAuth issuer and resource prefix: https://<TS_HOSTNAME>.<tailnet DNS suffix> (no trailing slash).
# DNS suffix: `tailscale status --json | jq -r .MagicDNSSuffix` (e.g. tail1234ab.ts.net)
# e.g. PUBLIC_BASE_URL=https://fitness-mcp.tail1234ab.ts.net
PUBLIC_BASE_URL=

# The only Tailscale login allowed to open the OAuth login page (the page is tailnet-only).
# Yours: `tailscale status --json | jq -r '.User[(.Self.UserID|tostring)].LoginName'`
# e.g. OWNER_TAILSCALE_LOGIN=jane@github
OWNER_TAILSCALE_LOGIN=

# Unprivileged UID/GID for all containers (deliberately not the host user).
# Secret files are made group-readable for APP_GID by scripts/setup-secrets.sh.
APP_UID=10001
APP_GID=10001

# Optional overrides of gateway/config.toml
# FUNNEL_TOKEN_CIDRS=160.79.104.0/21
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=7776000

# Optional: morning briefing from coach-mcp to your Telegram chat (off while COACH_TELEGRAM_CHAT_ID is empty).
# The message, including health values, goes to Telegram's servers and stays in the chat history (README,
# "Ranní briefing"). The bot token is a Docker secret: scripts/setup-secrets.sh telegram-token (it also prints
# the chat id to put here).
# COACH_TELEGRAM_CHAT_ID=
# COACH_BRIEFING_TIME=06:30
# COACH_BRIEFING_CUTOFF=09:30
# COACH_BRIEFING_RETRY_MINUTES=15
# Nightly history of Garmin daily values in coach-mcp (on by default) for get_trends and get_weekly_report. The
# first run reads COACH_HISTORY_BACKFILL_DAYS days back, about 5 Garmin Connect calls per day, one backend call
# every COACH_HISTORY_CALL_DELAY_SECONDS seconds. The data stays in the coach-data volume.
# COACH_HISTORY_ENABLED=true
# COACH_HISTORY_TIME=03:30
#   A time inside the briefing window (COACH_BRIEFING_TIME to COACH_BRIEFING_CUTOFF) is accepted; the run then
#   starts at the cutoff.
# COACH_HISTORY_BACKFILL_DAYS=90
# COACH_HISTORY_CALL_DELAY_SECONDS=15
